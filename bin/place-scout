#!/usr/bin/env bash
# Universal CLI wrapper for Google Maps Place Scout
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(dirname "$SCRIPT_DIR")"

# Robust Python interpreter detection (handling macOS Apple Silicon / x86 PATH conflicts)
PYTHON_BIN=""
for candidate in python3 /opt/homebrew/bin/python3 /usr/bin/python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
        if "$candidate" -c "import sys" >/dev/null 2>&1; then
            PYTHON_BIN="$candidate"
            break
        fi
    fi
done

if [ -z "$PYTHON_BIN" ]; then
    echo "Error: Working python3 interpreter not found." >&2
    exit 1
fi

exec "$PYTHON_BIN" "$SKILL_DIR/scripts/main.py" "$@"
